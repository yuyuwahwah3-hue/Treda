# ============================================================
#  Support & Resistance + EMA Cross Bot (H1) — Environment Variables
#  Copy file ini jadi .env untuk run lokal,
#  atau isi langsung di Railway → Variables
# ============================================================

# Bybit API Key (wajib)
API_KEY=isi_api_key_kamu_di_sini

# Bybit API Secret (wajib)
API_SECRET=isi_api_secret_kamu_di_sini

# Testnet mode: true = pakai Bybit Testnet, false = live trading
TESTNET=false

# ---- Parameter strategi (opsional, semua sudah ada default di kode) ----

# EMA cepat & lambat -- dicek cross-nya HARUS terjadi di candle c2
EMA_FAST=4
EMA_SLOW=10

# Limit baru dipasang NYATA di Bybit kalau harga dlm radius ini dari entry
# (ujung wick TEST1). Default: 0.02 = 2%
APPROACH_PCT=0.02

# Jarak SL dari entry, dalam desimal. Default: 0.02 = 2%
SL_PCT=0.02

# Rasio aktivasi trailing stop (1:N dari jarak entry-SL). Default: 4.0
TRAIL_ACT_R=4.0

# Lebar trailing stop = TRAIL_STOP x jarak(entry,SL). Default: 1.0
TRAIL_STOP=1.0

# Risk per trade (persen equity, dalam desimal). Default: 0.01 = 1%
RISK_PCT=0.01

# Leverage yang dipakai (dibatasi otomatis ke max_leverage tiap coin). Default: 25
LEVERAGE=25

# Jumlah slot maksimum (posisi aktif + order armed) bersamaan, semua koin. Default: 10
MAX_CONCURRENT=10

# Floor keamanan SL minimum dari entry (jaga2). Default: 0.002 = 0.2%
MIN_DIST_PCT=0.002

# Hedge mode: true = Long & Short boleh jalan bareng per koin. Default: true
ALLOW_HEDGE=true

# Path file state persistence (bertahan lewat restart/redeploy). Default: bot_state.json
# STATE_FILE_PATH=bot_state.json

# Port log server (Railway otomatis set ini, tidak perlu diubah)
# PORT=8080
